{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "spotcheck-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8737",
        "--bind",
        "127.0.0.1",
        "--directory",
        "spotcheck"
      ],
      "port": 8737
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "site"
      ],
      "port": 8765
    },
    {
      "name": "reports",
      "runtimeExecutable": "/Library/Developer/CommandLineTools/usr/bin/python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--bind",
        "127.0.0.1",
        "--directory",
        "data/app/reports"
      ],
      "port": 8766
    }
  ]
}
